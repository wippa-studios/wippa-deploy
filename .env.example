## Wippa — Environment Configuration
## Copy to .env and fill in your values before deploying.

AP_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js

## 256-bit encryption key (32 hex characters) — generate with: openssl rand -hex 16
AP_ENCRYPTION_KEY=

## JWT Secret — generate with: openssl rand -hex 32
AP_JWT_SECRET=

AP_ENVIRONMENT=prod
AP_FRONTEND_URL=http://localhost:8081
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5
AP_POSTGRES_DATABASE=wippa
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=wippa
AP_POSTGRES_PASSWORD=

AP_EXECUTION_MODE=UNSANDBOXED
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379
AP_FLOW_TIMEOUT_SECONDS=600
AP_TELEMETRY_ENABLED=false
AP_EDITION=ce

## Xero OAuth — register at https://developer.xero.com/app/manage/
## Enter through the Wippa admin UI at /platform/setup/credentials, not here

## Google OAuth — for "Sign in with Google"
AP_GOOGLE_CLIENT_ID=
AP_GOOGLE_CLIENT_SECRET=

## Microsoft OAuth — for Microsoft 365 integrations
AP_MICROSOFT_CLIENT_ID=
AP_MICROSOFT_CLIENT_SECRET=

## Stripe Billing (optional)
AP_STRIPE_SECRET_KEY=
AP_STRIPE_WEBHOOK_SECRET=
AP_STRIPE_MONTHLY_PRICE_ID=
